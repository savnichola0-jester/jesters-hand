{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "check-ins:daily": "pnpm run build && node --enable-source-maps ./dist/issueDailyCheckIns.mjs",
    "check-ins:scheduled": "pnpm run build && node --enable-source-maps ./dist/issueDailyCheckIns.mjs --scheduled",
    "check-ins:migrate-activation": "node --enable-source-maps ./scripts/migrate-check-in-activation.mjs",
    "test:check-in-batch": "node --experimental-strip-types --test scripts/check-in-batch-test.mjs",
    "test:check-in-schedule": "node --experimental-strip-types --test scripts/check-in-schedule-test.mjs",
    "test:game-room-access": "node --experimental-strip-types --test scripts/game-room-access-test.mjs",
    "test:games-content": "node --experimental-strip-types --test scripts/games-content-test.mjs",
    "test:games-emulator": "pnpm exec firebase emulators:exec --config scripts/check-in-emulator.firebase.json --only firestore --project demo-games \"FIRESTORE_EMULATOR_HOST=127.0.0.1:28080 EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-games NODE_ENV=test node scripts/run-games-emulator-test.mjs\"",
    "test:check-in-emulator": "pnpm exec firebase emulators:exec --config scripts/check-in-emulator.firebase.json --only firestore --project demo-check-in \"FIRESTORE_EMULATOR_HOST=127.0.0.1:28080 EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-check-in node scripts/run-check-in-emulator-test.mjs\"",
    "test:media-paths": "node --experimental-strip-types ./scripts/media-path-test.mjs",
    "test:dossiers": "node ./scripts/dossiers-test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "agora-token": "^2.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}

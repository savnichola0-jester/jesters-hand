{
  "expo": {
    "name": "Jester's Hand",
    "slug": "jesters-hand-native",
    "version": "1.0.1",
    "runtimeVersion": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jesters-hand",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0D0900"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jestershand.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Jester's Hand uses the microphone for live voice channels at Jester's Table."
      }
    },
    "android": {
      "package": "com.jestershand.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0D0900"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-dev-client",
      "expo-font",
      "expo-web-browser",
      "./plugins/withFirebaseInitialization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0D0900",
          "defaultChannel": "dispatches"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/e69e8635-ec36-4fa0-b2e8-3acca6a5188f"
    },
    "extra": {
      "apiDomain": "jestershand54atcomand.replit.app",
      "eas": {
        "projectId": "e69e8635-ec36-4fa0-b2e8-3acca6a5188f"
      }
    },
    "owner": "00-00"
  }
}

modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "rules-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "wipe-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "rules-drift-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "checkout-lines-test"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/jesters-hand && npx tsc --noEmit && cd ../api-server && npx tsc --noEmit && cd ../mockup-sandbox && npx tsc --noEmit"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "rules-test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/jesters-hand && firebase emulators:exec --only firestore,storage --project demo-rules-test \"node scripts/rules-test.mjs && node scripts/storage-rules-test.mjs\""

[[workflows.workflow]]
name = "wipe-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/jesters-hand && firebase emulators:exec --only firestore,storage --project demo-rules-test \"node ../api-server/scripts/wipe-test.mjs\""

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "rules-drift-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/jesters-hand && node scripts/rules-drift-check.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "checkout-lines-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && node scripts/checkout-lines-test.mjs"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

